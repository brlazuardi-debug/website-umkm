# Clerk — ambil Publishable Key dari Dashboard Clerk (API Keys)
# Wajib diisi, kalau kosong auth tidak berjalan (app akan menampilkan error di console).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Base URL API produksi (FastAPI eksternal, source of truth: /docs OpenAPI).
# Default menunjuk ke prod agar `npm run dev` langsung memakai data asli.
VITE_API_BASE_URL=https://umkmvarca.renaldi.my.id/api/v1
