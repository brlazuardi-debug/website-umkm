# Clerk — ambil Publishable Key dari Dashboard Clerk (API Keys)
# Wajib diisi, kalau kosong auth tidak berjalan (app akan menampilkan error di console).
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Base URL API backend. Kosongkan (atau '/api/v1') untuk proxy relatif via Vite/dev.
# Saat produksi arahkan ke origin backend, mis. https://api.example.com/api/v1
VITE_API_BASE_URL=/api/v1
